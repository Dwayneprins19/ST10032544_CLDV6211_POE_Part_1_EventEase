@model EventEase.Models.Booking

<h1>Create Booking</h1>

<div asp-validation-summary="All"
    class="text-danger"></div>

<form asp-action="Create">
    
    <div class="mb-3">
        <label asp-for="VenueId"></label>

        <select asp-for="VenueId"
                asp-items="ViewBag.VenueId"
                class="form-control">
        </select>
    </div>
    <div class="mb-3">
        <label asp-for="EventId"></label>

        <select asp-for="EventId"
                asp-items="ViewBag.EventId"
                class="form-control">
        </select>
    </div>

    <div class="mb-3">
        <label asp-for="BookingDate"></label>
        <select asp-for="BookingDate"
                class="form-control">
        </select>
    </div>

    <div class="mb-3">
        <label asp-for="StartTime"></label>
        <select asp-for="StartTime"
                class="form-control">
        </select>
    </div>

    <div class="mb-3">
        <label asp-for="EndTime"></label>
        <select asp-for="EndTime"
                class="form-control">
        </select>
    </div>

    <button type="submit" class="btn btn-success">
        Save Booking
    </button>

</form>